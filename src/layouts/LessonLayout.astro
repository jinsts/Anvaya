---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SectionTOC from '../components/learning/SectionTOC.astro';
import InterviewPractice from '../components/learning/InterviewPractice.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Icon from '../components/ui/Icon.astro';
import { capitalize } from '../lib/format';
import {
  getCatalog,
  lessonLabel,
  lessonUrlIn,
  type Lesson,
} from '../lib/catalog';
import {
  categoryAncestors,
  categoryUrl,
  lessonUrl,
  neighbors,
  pathLessonIds,
  pathUrl,
  subjectUrl,
} from '../lib/path-model';
interface Props {
  lesson: Lesson;
  headings: MarkdownHeading[];
}
const { lesson, headings } = Astro.props;
const {
  lessonById,
  pathsByLesson,
  subjectById,
  categories,
  problemsByLesson,
  sources,
} = await getCatalog();
const studyPaths = pathsByLesson.get(lesson.id) ?? [];
const defaultPath =
  studyPaths.find((path) => path.id === lesson.data.path) ?? studyPaths[0];
const subject = subjectById.get(lesson.data.subject)!;
const ancestry = categoryAncestors(subject.category, categories);
const lessonAt = (id: string) => lessonById.get(id)!;
const problems = problemsByLesson.get(lesson.id) ?? [];
const { interviewQuestions, status, drafter, reviewedAt } = lesson.data;
const hasPractice = interviewQuestions.length > 0 || problems.length > 0;
const outline = [
  ...headings,
  ...(hasPractice
    ? [{ depth: 2, slug: 'interview-practice', text: 'Interview practice' }]
    : []),
  { depth: 2, slug: 'sources', text: 'Sources & further reading' },
];
const reviewDate = reviewedAt?.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const statusLabel =
  status === 'draft'
    ? `${drafter === 'agent' ? 'Agent draft' : 'Draft'} · awaiting review`
    : `${capitalize(status)} ${reviewDate}`;
const sourcesNote =
  status === 'draft'
    ? `This ${drafter === 'agent' ? 'agent-written ' : ''}draft has not been reviewed yet. Check its claims against these sources.`
    : `Reviewed by the owner on ${reviewDate}. These sources support its models and caveats.`;
---

<BaseLayout
  title={lesson.data.title}
  description={lesson.data.summary}
  activePath={defaultPath}
>
  <div
    class="lesson"
    data-default-path={defaultPath?.id}
    data-lesson-page={lesson.id}
    data-lesson-title={lesson.data.title}
    data-tone={subject.tone}
    data-pagefind-body
    data-pagefind-filter="type:Lesson"
    data-pagefind-meta={`subject:${subject.title}`}
  >
    <Breadcrumbs
      items={[
        { label: 'Explore', href: '/explore/' },
        ...ancestry.map((category) => ({
          label: category.title,
          href: categoryUrl(category.id),
        })),
        { label: subject.title, href: subjectUrl(subject.id) },
      ]}
    />
    <header class="lesson-hero">
      <div class="hero-context" data-pagefind-ignore>
        <span class="icon-tile">
          <Icon name={subject.icon} size={20} />
        </span>
        {studyPaths.length ? (
          studyPaths.map((path) => (
            <p
              class="path-position"
              data-path-context={path.id}
              hidden={path.id !== defaultPath?.id}
            >
              <a href={pathUrl(path.id)}>{path.title}</a>
              <span aria-hidden="true"> · </span>
              Lesson {pathLessonIds(path).indexOf(lesson.id) + 1} of{' '}
              {pathLessonIds(path).length}
            </p>
          ))
        ) : (
          <p class="path-position">
            <a href={subjectUrl(subject.id)}>{subject.title}</a>
          </p>
        )}
      </div>
      <h1>{lesson.data.title}</h1>
      <p class="lede">{lesson.data.summary}</p>
      <div class="hero-facts" data-pagefind-ignore>
        <span class="fact">
          <Icon name="clock" size={16} /> {lesson.data.estimatedMinutes} min
          read & practice
        </span>
        <span class="fact">
          <Icon name="signal" size={16} /> {capitalize(lesson.data.difficulty)}
        </span>
        <span
          class="badge"
          data-variant={status === 'draft' ? 'draft' : 'success'}
        >
          {statusLabel}
        </span>
        <button
          type="button"
          class="complete-toggle js-only"
          data-complete-toggle
          data-lesson-id={lesson.id}
          aria-pressed="false"
        >
          <Icon name="circle-check" size={16} />
          <span data-complete-text>Mark as complete</span>
        </button>
      </div>
    </header>
    <div class="lesson-grid">
      <article class="prose" aria-label={lesson.data.title}>
        <SectionTOC headings={outline} variant="mobile" />
        <section class="orientation" aria-label="Before you begin">
          <p class="prereqs">
            <strong>Before you begin</strong>
            {lesson.data.prerequisites.length
              ? lesson.data.prerequisites.map((id, index) => (
                  <>
                    <span>{index ? ', ' : ' '}</span>
                    <a href={lessonUrl(id)}>{lessonAt(id).data.title}</a>
                  </>
                ))
              : ' No prerequisite lessons. Start here.'}
          </p>
          <div class="objectives">
            <p class="eyebrow">What you’ll be able to do</p>
            <ul>
              {lesson.data.learningObjectives.map((objective) => (
                <li>
                  <Icon name="check" size={16} />
                  {objective}
                </li>
              ))}
            </ul>
          </div>
        </section>
        <slot />
        {hasPractice && (
          <InterviewPractice
            lessonId={lesson.id}
            questions={interviewQuestions}
            problems={problems}
            sources={sources}
          />
        )}
        <h2 id="sources">Sources & further reading</h2>
        <p class="muted">{sourcesNote}</p>
        <ul>
          {lesson.data.sources.map((source) => (
            <li>
              <a href={source.url}>{source.label}</a>
            </li>
          ))}
        </ul>
        <div class="lesson-end js-only" data-pagefind-ignore>
          <p>Finished the practice and the recap?</p>
          <button
            type="button"
            class="complete-toggle"
            data-complete-toggle
            data-lesson-id={lesson.id}
            aria-pressed="false"
          >
            <Icon name="circle-check" size={16} />
            <span data-complete-text>Mark as complete</span>
          </button>
        </div>
        {studyPaths.map((path) => {
          const adjacent = neighbors(pathLessonIds(path), lesson.id);
          return (
            <nav
              class="lesson-pagination"
              aria-label="Adjacent lessons"
              data-path-context={path.id}
              data-pagefind-ignore
              hidden={path.id !== defaultPath?.id}
            >
              {adjacent.previous && (
                <a
                  class="previous"
                  href={lessonUrlIn(lessonAt(adjacent.previous), path.id)}
                >
                  <small>
                    <Icon name="arrow-left" size={14} /> Previous lesson
                  </small>
                  {lessonLabel(lessonAt(adjacent.previous))}
                </a>
              )}
              {adjacent.next && (
                <a
                  class="next"
                  href={lessonUrlIn(lessonAt(adjacent.next), path.id)}
                >
                  <small>
                    Next lesson <Icon name="arrow-right" size={14} />
                  </small>
                  {lessonLabel(lessonAt(adjacent.next))}
                </a>
              )}
            </nav>
          );
        })}
      </article>
      <aside class="lesson-outline" data-pagefind-ignore>
        <SectionTOC headings={outline} />
      </aside>
    </div>
  </div>
</BaseLayout>
<script>
  import { initPathContext } from '../scripts/path-context';
  initPathContext();
</script>
<style>
  .lesson-hero {
    margin-bottom: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 100% 0%, var(--tone-soft), transparent 55%),
      var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .hero-context {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .path-position {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .path-position a {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .path-position a:hover {
    color: var(--accent);
  }
  .lesson-hero h1 {
    margin-bottom: var(--space-3);
  }
  .lesson-hero .lede {
    margin-bottom: var(--space-5);
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .fact {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .complete-toggle {
    margin-left: auto;
  }
  .complete-toggle[aria-pressed='true'] {
    border-color: var(--success);
    background: var(--success-soft);
    color: var(--success);
  }
  .lesson-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: var(--space-12);
  }
  .lesson-outline {
    min-width: 0;
  }
  .prose :global(.toc-mobile) {
    display: none;
  }
  .orientation {
    max-width: var(--article-measure);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    font-size: var(--text-base);
    line-height: var(--leading);
  }
  .prereqs {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }
  .prereqs strong {
    margin-right: var(--space-1);
    color: var(--text);
  }
  .objectives {
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  .objectives .eyebrow {
    color: var(--accent);
  }
  .objectives ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .objectives li {
    display: flex;
    gap: var(--space-3);
    margin: 0;
  }
  .objectives li :global(.icon) {
    flex: none;
    margin-top: 0.3em;
    color: var(--success);
  }
  .lesson-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--article-measure);
    margin-top: var(--space-10);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    font-size: var(--text-base);
  }
  .lesson-end p {
    margin: 0;
    font-weight: 600;
  }
  .lesson-end .complete-toggle {
    margin-left: 0;
  }
  .lesson-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: var(--article-measure);
    margin-top: var(--space-6);
  }
  .lesson-pagination a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-base);
    font-weight: 650;
    text-decoration: none;
  }
  .lesson-pagination a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .lesson-pagination .next {
    grid-column: 2;
    text-align: right;
  }
  .lesson-pagination small {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 550;
  }
  .lesson-pagination .next small {
    justify-content: flex-end;
  }
  @media (max-width: 1200px) {
    .lesson-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .lesson-outline {
      display: none;
    }
    .prose :global(.toc-mobile) {
      display: block;
      max-width: var(--article-measure);
    }
  }
  @media (max-width: 760px) {
    .lesson-hero {
      padding: var(--space-5);
    }
    .complete-toggle {
      margin-left: 0;
    }
    .lesson-pagination {
      grid-template-columns: minmax(0, 1fr);
    }
    .lesson-pagination .next {
      grid-column: 1;
    }
  }
</style>
