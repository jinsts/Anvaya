---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Icon from '../components/ui/Icon.astro';
import { getCatalog, lessonLabel, lessonUrlIn } from '../lib/catalog';
import {
  categoryUrl,
  pathLessonIds,
  pathSections,
  pathUrl,
  subjectUrl,
  subjectsInCategory,
  type LearningPath,
} from '../lib/path-model';
import type { IconName } from '../lib/icons';
interface Props {
  title: string;
  description?: string;
  activePath?: LearningPath;
}
const {
  title,
  description = 'Connect concepts. Build understanding. A personal learning library.',
  activePath,
} = Astro.props;
const {
  lessonById,
  pathsByLesson,
  categories,
  availableSubjects: subjects,
} = await getCatalog();
const current = Astro.url.pathname;
const currentLesson = current.startsWith('/learn/')
  ? lessonById.get(current.slice('/learn/'.length).replace(/\/$/, ''))
  : undefined;
const studyPaths = currentLesson
  ? (pathsByLesson.get(currentLesson.id) ?? [])
  : activePath
    ? [activePath]
    : [];
const defaultPath =
  activePath ??
  studyPaths.find((path) => path.id === currentLesson?.data.path) ??
  studyPaths[0];
const rootCategories = categories.filter(
  (category) =>
    !category.parent &&
    subjectsInCategory(category.id, subjects, categories).length,
);
const navItems: {
  href: string;
  title: string;
  icon: IconName;
  active: boolean;
}[] = [
  { href: '/', title: 'Home', icon: 'house', active: current === '/' },
  {
    href: '/explore/',
    title: 'Explore',
    icon: 'compass',
    active: current.startsWith('/explore') || current.startsWith('/subjects'),
  },
  {
    href: '/paths/',
    title: 'Learning paths',
    icon: 'route',
    active: current.startsWith('/paths'),
  },
  {
    href: '/practice/',
    title: 'Practice',
    icon: 'target',
    active: current.startsWith('/practice'),
  },
  {
    href: '/concepts/',
    title: 'Search',
    icon: 'search',
    active: current.startsWith('/concepts'),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Anvaya</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('anvaya:theme:v1');
        document.documentElement.dataset.theme =
          theme === 'light' || theme === 'dark'
            ? theme
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch {
        document.documentElement.dataset.theme = matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches
          ? 'dark'
          : 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Anvaya home">
        <img src="/favicon.svg" alt="" width="28" height="28" />
        <span>Anvaya</span>
      </a>
      <details class="explore-menu">
        <summary>
          Explore <Icon name="chevron-down" size={16} />
        </summary>
        <div class="explore-popover">
          <a class="explore-all" href="/explore/">
            Explore all subjects <Icon name="arrow-right" size={16} />
          </a>
          {rootCategories.map((category) => {
            const inCategory = subjectsInCategory(
              category.id,
              subjects,
              categories,
            );
            return (
              <div class="explore-group">
                <a class="explore-category" href={categoryUrl(category.id)}>
                  {category.title}
                </a>
                <ul>
                  {inCategory.slice(0, 6).map((subject) => (
                    <li>
                      <a href={subjectUrl(subject.id)} data-tone={subject.tone}>
                        <span class="icon-tile">
                          <Icon name={subject.icon} size={16} />
                        </span>
                        {subject.title}
                      </a>
                    </li>
                  ))}
                </ul>
                {inCategory.length > 6 && (
                  <a class="explore-more" href={categoryUrl(category.id)}>
                    All {inCategory.length} subjects
                  </a>
                )}
              </div>
            );
          })}
        </div>
      </details>
      <form
        class="global-search"
        role="search"
        aria-label="Site"
        action="/concepts/"
      >
        <Icon name="search" size={16} />
        <input
          type="search"
          name="q"
          placeholder="Search lessons and practice"
          aria-label="Search all learning"
          aria-keyshortcuts="/"
        />
        <kbd aria-hidden="true">/</kbd>
      </form>
      <div class="header-controls">
        <a
          class="icon-button mobile-search"
          href="/concepts/"
          aria-label="Search library"
        >
          <Icon name="search" size={20} />
        </a>
        <div class="theme-control">
          <Icon name="sun-moon" size={17} />
          <select id="theme" aria-label="Color theme">
            <option value="system">System</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </div>
        <button
          id="menu-toggle"
          class="icon-button"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <Icon name="menu" size={20} />
          <span class="sr-only">Menu</span>
        </button>
      </div>
    </header>
    <button
      class="menu-backdrop"
      aria-label="Close navigation"
      hidden
      tabindex="-1"
    ></button>
    <aside class="sidebar" id="site-nav">
      <nav aria-label="Main navigation" class="main-nav">
        {navItems.map((item) => (
          <a
            class="nav-link"
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
          >
            <Icon name={item.icon} />
            {item.title}
          </a>
        ))}
      </nav>
      {studyPaths.length ? (
        studyPaths.map((path) => (
          <div
            class="path-sidebar"
            data-path-sidebar={path.id}
            data-path-context={path.id}
            data-progress-scope
            hidden={path.id !== defaultPath?.id}
          >
            <p class="nav-heading">Learning path</p>
            <a href={pathUrl(path.id)} class="path-title">
              {path.title}
            </a>
            <p class="path-count">
              <span data-progress-text>
                {pathLessonIds(path).length} lessons
              </span>
            </p>
            <div
              class="progress js-only"
              role="progressbar"
              aria-label={`Progress in ${path.title}`}
              aria-valuemin="0"
              aria-valuemax={pathLessonIds(path).length}
              aria-valuenow="0"
              data-progress-bar
            />
            <nav aria-label={`Lessons in ${path.title}`}>
              {pathSections(path).map((section) => (
                <details class="path-section" open>
                  <summary>
                    {section.title}
                    <Icon name="chevron-down" size={14} />
                  </summary>
                  <ol>
                    {section.lessons.map((id) => {
                      const lesson = lessonById.get(id)!;
                      return (
                        <li>
                          <a
                            class="lesson-link"
                            href={lessonUrlIn(lesson, path.id)}
                            data-lesson-id={id}
                            data-label={lessonLabel(lesson)}
                            aria-current={
                              currentLesson?.id === id ? 'page' : undefined
                            }
                          >
                            <span class="lesson-marker" aria-hidden="true">
                              <span class="lesson-number">
                                {String(
                                  pathLessonIds(path).indexOf(id) + 1,
                                ).padStart(2, '0')}
                              </span>
                              <Icon
                                name="check"
                                size={13}
                                class="lesson-check"
                              />
                            </span>
                            {lessonLabel(lesson)}
                            <span class="sr-only" data-complete-label hidden>
                              (completed)
                            </span>
                          </a>
                        </li>
                      );
                    })}
                  </ol>
                </details>
              ))}
            </nav>
            {studyPaths.length > 1 && (
              <div class="path-switcher">
                <label for={`path-switch-${path.id}`}>
                  Change learning path
                </label>
                <select id={`path-switch-${path.id}`} data-path-switch>
                  {studyPaths.map((option) => (
                    <option value={option.id} selected={option.id === path.id}>
                      {option.title}
                    </option>
                  ))}
                </select>
              </div>
            )}
            <a class="sidebar-back" href="/explore/">
              <Icon name="arrow-left" size={15} /> All subjects
            </a>
          </div>
        ))
      ) : (
        <nav class="subject-navigation" aria-label="Browse subjects">
          <p class="nav-heading">Browse</p>
          {rootCategories.map((category) => (
            <a class="category-link" href={categoryUrl(category.id)}>
              {category.title}
              <Icon name="chevron-right" size={14} />
            </a>
          ))}
          <a class="sidebar-back" href="/explore/">
            View the library <Icon name="arrow-right" size={15} />
          </a>
        </nav>
      )}
    </aside>
    <div class="workspace">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer>
        <span>Anvaya · Connect concepts. Build understanding.</span>
        <span>Progress is saved in this browser only.</span>
      </footer>
    </div>
    <script>
      import { initProgressUI } from '../scripts/progress-ui';
      const select = document.querySelector<HTMLSelectElement>('#theme');
      const system = matchMedia('(prefers-color-scheme: dark)');
      const applyTheme = () => {
        const choice = select?.value ?? 'system';
        const root = document.documentElement;
        // Switch colors instantly instead of animating every control.
        root.classList.add('theme-switching');
        root.dataset.theme =
          choice === 'system' ? (system.matches ? 'dark' : 'light') : choice;
        requestAnimationFrame(() =>
          requestAnimationFrame(() => root.classList.remove('theme-switching')),
        );
      };
      if (select) {
        try {
          const stored = localStorage.getItem('anvaya:theme:v1');
          select.value =
            stored === 'light' || stored === 'dark' ? stored : 'system';
        } catch {
          /* Storage is optional. */
        }
        select.addEventListener('change', () => {
          applyTheme();
          try {
            localStorage.setItem('anvaya:theme:v1', select.value);
          } catch {
            /* Theme still works. */
          }
        });
        system.addEventListener('change', applyTheme);
        applyTheme();
      }
      const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      const workspace = document.querySelector<HTMLElement>('.workspace');
      const backdrop =
        document.querySelector<HTMLButtonElement>('.menu-backdrop');
      const mobile = matchMedia('(max-width: 760px)');
      const close = () => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('open');
        if (workspace) workspace.inert = false;
        if (backdrop) backdrop.hidden = true;
        document.body.classList.remove('navigation-open');
      };
      toggle?.addEventListener('click', () => {
        if (toggle.getAttribute('aria-expanded') === 'true') {
          close();
          return;
        }
        toggle.setAttribute('aria-expanded', 'true');
        nav?.classList.add('open');
        if (workspace) workspace.inert = mobile.matches;
        if (backdrop) backdrop.hidden = false;
        document.body.classList.add('navigation-open');
        nav?.querySelector<HTMLAnchorElement>('a')?.focus();
      });
      backdrop?.addEventListener('click', () => {
        close();
        toggle?.focus();
      });
      mobile.addEventListener('change', close);
      nav
        ?.querySelectorAll('a')
        .forEach((link) => link.addEventListener('click', close));
      const explore =
        document.querySelector<HTMLDetailsElement>('.explore-menu');
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !explore?.contains(event.target))
          explore?.removeAttribute('open');
      });
      const search = document.querySelector<HTMLInputElement>(
        '.global-search input',
      );
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          if (toggle?.getAttribute('aria-expanded') === 'true') {
            close();
            toggle.focus();
          }
          if (explore?.open) {
            explore.open = false;
            explore.querySelector('summary')?.focus();
          }
          return;
        }
        const target = event.target as HTMLElement;
        const typing =
          target.isContentEditable ||
          ['INPUT', 'SELECT', 'TEXTAREA'].includes(target.tagName);
        if (
          event.key === '/' &&
          !typing &&
          !event.metaKey &&
          !event.ctrlKey &&
          search?.offsetParent
        ) {
          event.preventDefault();
          search.focus();
        }
      });
      initProgressUI();
    </script>
  </body>
</html>
<style>
  .skip {
    position: fixed;
    top: -100px;
    left: var(--space-4);
    z-index: 100;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .skip:focus {
    top: var(--space-3);
  }
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--header-height);
    padding: 0 var(--space-5);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .brand {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-2);
    width: calc(var(--sidebar-width) - var(--space-5) - var(--space-6));
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .explore-menu {
    position: relative;
    flex-shrink: 0;
  }
  .explore-menu summary {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 550;
    list-style: none;
    cursor: pointer;
  }
  .explore-menu summary::-webkit-details-marker {
    display: none;
  }
  .explore-menu[open] summary,
  .explore-menu summary:hover {
    background: var(--subtle);
  }
  .explore-popover {
    position: absolute;
    top: calc(100% + var(--space-3));
    left: 0;
    width: 340px;
    max-height: calc(100dvh - 100px);
    overflow: auto;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .explore-popover a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .explore-popover a:hover {
    background: var(--subtle);
  }
  .explore-all {
    justify-content: space-between;
    font-weight: 600;
  }
  .explore-group {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }
  .explore-popover .explore-category {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .explore-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .explore-group .icon-tile {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
  }
  .explore-popover .explore-more {
    color: var(--accent);
  }
  .global-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: min(440px, 38vw);
    padding: 0 var(--space-2) 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--muted);
  }
  .global-search:focus-within {
    border-color: var(--accent);
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }
  .global-search input {
    width: 100%;
    min-width: 0;
    min-height: 38px;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    font-size: var(--text-sm);
  }
  .header-controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }
  .icon-button {
    display: inline-grid;
    place-items: center;
    width: 40px;
    min-height: 40px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
  }
  .icon-button:hover {
    background: var(--subtle);
  }
  .theme-control {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--muted);
  }
  .theme-control :global(.icon) {
    position: absolute;
    left: var(--space-3);
    pointer-events: none;
  }
  .theme-control select {
    min-height: 36px;
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-8);
    border-color: var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
  }
  #menu-toggle,
  .mobile-search {
    display: none;
  }
  .sidebar {
    position: fixed;
    top: var(--header-height);
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: var(--sidebar-width);
    overflow-y: auto;
    padding: var(--space-5) var(--space-3);
    border-right: 1px solid var(--border);
    background: var(--surface);
  }
  .main-nav {
    display: grid;
    gap: 2px;
  }
  .nav-heading {
    margin: 0 var(--space-3) var(--space-2);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 550;
    text-decoration: none;
  }
  .nav-link:hover {
    background: var(--subtle);
    color: var(--text);
  }
  .nav-link[aria-current] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 650;
  }
  .subject-navigation,
  .path-sidebar {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .category-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .category-link:hover {
    background: var(--subtle);
  }
  .sidebar-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) var(--space-3) 0;
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .sidebar-back:hover {
    color: var(--accent);
  }
  .path-title {
    display: block;
    padding: 0 var(--space-3);
    color: var(--text);
    font-size: var(--text-base);
    font-weight: 650;
    line-height: var(--leading-snug);
    text-decoration: none;
  }
  .path-title:hover {
    color: var(--accent);
  }
  .path-count {
    margin: var(--space-1) var(--space-3) var(--space-2);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .path-sidebar .progress {
    margin: 0 var(--space-3) var(--space-3);
  }
  .path-section summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }
  .path-section summary::-webkit-details-marker {
    display: none;
  }
  .path-section:not([open]) summary :global(.icon) {
    transform: rotate(-90deg);
  }
  .path-section ol {
    margin: 0 0 var(--space-2);
    padding: 0;
    list-style: none;
  }
  .lesson-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .lesson-link:hover {
    background: var(--subtle);
    color: var(--text);
  }
  .lesson-link[aria-current] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .lesson-marker {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .lesson-marker :global(.lesson-check) {
    display: none;
  }
  .lesson-link[data-complete] .lesson-marker {
    border-color: var(--success);
    background: var(--success);
    color: var(--surface);
  }
  .lesson-link[data-complete] .lesson-number {
    display: none;
  }
  .lesson-link[data-complete] :global(.lesson-check) {
    display: block;
  }
  .lesson-number {
    font-size: var(--text-xs);
  }
  .path-switcher {
    margin: var(--space-4) var(--space-3);
  }
  .path-switcher label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
  }
  .path-switcher select {
    width: 100%;
    font-size: var(--text-sm);
  }
  .workspace {
    min-width: 0;
    margin-left: var(--sidebar-width);
  }
  main {
    max-width: var(--content-max);
    min-width: 0;
    min-height: calc(100dvh - 120px);
    margin: auto;
    padding: var(--space-8) clamp(var(--space-5), 4vw, var(--space-10))
      var(--space-12);
    outline: none;
  }
  footer {
