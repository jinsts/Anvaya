---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import PathCard from '../components/catalog/PathCard.astro';
import SubjectCard from '../components/catalog/SubjectCard.astro';
import { capitalize, plural } from '../lib/format';
import { getCatalog } from '../lib/catalog';
import { categoryAncestors, lessonUrl, pathLessonIds } from '../lib/path-model';
const {
  lessons,
  lessonById,
  paths,
  categories,
  subjectById,
  availableSubjects: subjects,
  problems,
  problemsByLesson,
} = await getCatalog();
const activePaths = paths.filter((path) => pathLessonIds(path).length > 0);
// Paths are sorted by `order`, so the first one is the suggested starting point.
const startPath = activePaths[0];
const startLesson = startPath
  ? lessonById.get(pathLessonIds(startPath)[0]!)
  : lessons[0];
const questionCount = lessons.reduce(
  (count, lesson) => count + lesson.data.interviewQuestions.length,
  0,
);
const subjectStats = (id: string) => {
  const subjectLessons = lessons.filter((lesson) => lesson.data.subject === id);
  return {
    lessons: subjectLessons.length,
    paths: activePaths.filter((path) => path.subject === id).length,
    problems: new Set(
      subjectLessons.flatMap((lesson) =>
        (problemsByLesson.get(lesson.id) ?? []).map((problem) => problem.id),
      ),
    ).size,
  };
};
---

<BaseLayout title="Home">
  <header class="home-header">
    <div>
      <p class="eyebrow">Your learning workspace</p>
      <h1>Connect concepts. Build understanding.</h1>
      <p class="lede">
        Pick up where you left off, follow a path, or rehearse for interviews.
      </p>
    </div>
    <dl class="library-stats" aria-label="Library contents">
      <div>
        <dt>Subjects</dt>
        <dd>{subjects.length}</dd>
      </div>
      <div>
        <dt>Paths</dt>
        <dd>{activePaths.length}</dd>
      </div>
      <div>
        <dt>Lessons</dt>
        <dd>{lessons.length}</dd>
      </div>
      <div>
        <dt>Problems</dt>
        <dd>{problems.length}</dd>
      </div>
    </dl>
  </header>

  <div class="home-top">
    {startLesson && (
      <section
        class="card continue"
        aria-labelledby="continue-title"
        data-continue
        data-tone={subjectById.get(startLesson.data.subject)?.tone}
      >
        <p class="eyebrow" data-continue-label>
          Start here
        </p>
        <h2 id="continue-title">
          <a href={lessonUrl(startLesson.id)} data-continue-link>
            {startLesson.data.title}
          </a>
        </h2>
        <p class="muted" data-continue-summary>
          {startLesson.data.summary}
        </p>
        <div class="continue-foot">
          <p class="continue-facts" data-continue-static>
            <span>
              <Icon name="clock" size={15} />{' '}
              {startLesson.data.estimatedMinutes} min
            </span>
            <span>
              <Icon name="signal" size={15} />{' '}
              {capitalize(startLesson.data.difficulty)}
            </span>
          </p>
          <a
            class="button button-primary"
            href={lessonUrl(startLesson.id)}
            data-continue-link
          >
            <span data-continue-button-label>Start lesson</span>
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </section>
    )}
    <section
      class="card practice-summary"
      aria-labelledby="practice-title"
      data-practice-summary
      data-problem-ids={problems.map((problem) => problem.id).join(' ')}
    >
      <div class="practice-head">
        <span class="icon-tile">
          <Icon name="target" size={20} />
        </span>
        <h2 id="practice-title">Interview practice</h2>
      </div>
      <p class="practice-counts">
        <span data-solved-text>
          {plural(problems.length, 'practice problem')}
        </span>
        <span data-review-text>
          {plural(questionCount, 'question')} to rehearse
        </span>
      </p>
      <div
        class="progress js-only"
        role="progressbar"
        aria-label="Problems solved"
        aria-valuemin="0"
        aria-valuemax={problems.length}
        aria-valuenow="0"
        data-progress-bar
      ></div>
      <div class="actions">
        <a class="button" href="/practice/">
          <Icon name="target" size={16} /> Practice problems
        </a>
        <a class="button" href="/practice/questions/">
          <Icon name="message-circle-question-mark" size={16} /> Drill questions
        </a>
      </div>
    </section>
  </div>

  {activePaths.length > 0 && (
    <section aria-labelledby="paths-title">
      <div class="section-head">
        <h2 id="paths-title">Learning paths</h2>
        <a href="/paths/">
          All paths <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <div class="card-grid">
        {activePaths.slice(0, 6).map((path) => (
          <PathCard
            path={path}
            subject={subjectById.get(path.subject)!}
            lessons={pathLessonIds(path).map((id) => lessonById.get(id)!)}
          />
        ))}
      </div>
    </section>
  )}

  <section aria-labelledby="subjects-title">
    <div class="section-head">
      <h2 id="subjects-title">Subjects</h2>
      <a href="/explore/">
        Explore subjects <Icon name="arrow-right" size={16} />
      </a>
    </div>
    {subjects.length ? (
      <div class="card-grid">
        {subjects.slice(0, 6).map((subject) => (
          <SubjectCard
            subject={subjectById.get(subject.id)!}
            trail={categoryAncestors(subject.category, categories)
              .map((category) => category.title)
              .join(' / ')}
            {...subjectStats(subject.id)}
          />
        ))}
      </div>
    ) : (
      <p class="card empty-state">
        Your library is ready for its first subject.
      </p>
    )}
  </section>

  <section class="data-panel" aria-labelledby="data-title">
    <div>
      <h2 id="data-title">Your progress data</h2>
      <p class="muted">
        Progress is saved only in this browser. Export it as a backup or to move
        it to another device.
      </p>
    </div>
    <div class="actions js-only">
      <button type="button" data-progress-export>
        <Icon name="download" size={16} /> Export
      </button>
      <label class="button">
        <Icon name="upload" size={16} /> Import
        <input
          class="sr-only"
          type="file"
          accept="application/json,.json"
          data-progress-import
        />
      </label>
      <button type="button" data-progress-clear>
        <Icon name="trash" size={16} /> Clear
      </button>
    </div>
    <p class="data-message" role="status" data-progress-message></p>
  </section>
</BaseLayout>
<style>
  .home-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .home-header h1 {
    margin-bottom: var(--space-2);
  }
  .home-header .lede {
    margin: 0;
  }
  .library-stats {
    display: flex;
    gap: var(--space-2);
    margin: 0;
  }
  .library-stats div {
    min-width: 76px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .library-stats dt {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .library-stats dd {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .home-top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-5);
  }
  .continue {
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(circle at 100% 0%, var(--tone-soft), transparent 60%),
      var(--surface);
  }
  .continue .eyebrow {
    color: var(--tone);
  }
  .continue h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-2xl);
  }
  .continue h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .continue h2 a:hover {
    color: var(--accent);
  }
  .continue-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
  }
  .continue-facts {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .continue-facts span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .practice-summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .practice-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .practice-head h2 {
    margin: 0;
    font-size: var(--text-lg);
  }
  .practice-counts {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .practice-summary .actions {
    margin-top: auto;
  }
  .data-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .data-panel h2 {
    margin-bottom: var(--space-1);
    font-size: var(--text-base);
  }
  .data-panel p {
    margin: 0;
    font-size: var(--text-sm);
  }
  .data-panel label:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .data-message:empty {
    display: none;
  }
  .data-message {
    flex-basis: 100%;
  }
  @media (max-width: 900px) {
    .home-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .library-stats {
      width: 100%;
    }
    .library-stats div {
      flex: 1;
      min-width: 0;
      padding: var(--space-2) var(--space-3);
    }
  }
</style>
