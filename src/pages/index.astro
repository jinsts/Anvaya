---
import BaseLayout from '../layouts/BaseLayout.astro';
import LessonCard from '../components/learning/LessonCard.astro';
import Icon from '../components/ui/Icon.astro';
import { getCatalog } from '../lib/catalog';
import {
  categoryAncestors,
  lessonUrl,
  pathLessonIds,
  pathUrl,
  subjectUrl,
} from '../lib/path-model';
const {
  lessons,
  paths,
  availableSubjects: subjects,
  categories,
} = await getCatalog();
const availablePaths = paths.filter((path) => pathLessonIds(path).length > 0);
const featured = availablePaths[0];
const arrayPreview = lessons.find((lesson) => lesson.id === 'dsa/arrays');
---

<BaseLayout title="Your learning workspace">
  <section class="welcome" aria-labelledby="welcome-title">
    <div class="welcome-copy">
      <span class="eyebrow">Your personal learning library</span>
      <h1 id="welcome-title">
        Connect concepts.
        <br />
        <span>Build understanding.</span>
      </h1>
      <p class="lede">
        Follow your curiosity. Explore an idea, try it for yourself, and build
        knowledge you can return to.
      </p>
      <div class="actions">
        <a class="button" href="/explore/">
          Explore subjects <span aria-hidden="true">↗</span>
        </a>
        <a class="button secondary" href="/paths/">
          Find a learning path
        </a>
      </div>
      <div class="library-meta" aria-label="Library contents">
        <span>
          <strong>{subjects.length}</strong>{' '}
          {subjects.length === 1 ? 'subject' : 'subjects'}
        </span>
        <span>
          <strong>{availablePaths.length}</strong>{' '}
          {availablePaths.length === 1 ? 'learning path' : 'learning paths'}
        </span>
        <span>
          <strong>{lessons.length}</strong>{' '}
          {lessons.length === 1 ? 'lesson' : 'lessons'}
        </span>
      </div>
    </div>
    {arrayPreview && (
      <div class="idea-preview">
        <div class="preview-top">
          <span class="eyebrow">An idea to explore</span>
          <span class="badge">Interactive lesson</span>
        </div>
        <h2>{arrayPreview.data.title}</h2>
        <p class="muted">See how an index leads straight to a value.</p>
        <figure aria-label="Array preview: index 2 holds the value 36">
          <div class="preview-cells">
            {[12, 24, 36, 48].map((value, index) => (
              <div class:list={['preview-cell', { selected: index === 2 }]}>
                <small>index {index}</small>
                <strong>{value}</strong>
                <span>{index === 2 ? 'selected' : '\u00a0'}</span>
              </div>
            ))}
          </div>
          <figcaption>
            <code>array[2]</code>
            <span aria-hidden="true"> → </span>
            <strong>36</strong>
          </figcaption>
        </figure>
        <a class="preview-link" href={lessonUrl(arrayPreview.id)}>
          Start with Arrays <span aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </section>
  <section aria-labelledby="subjects-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Follow your curiosity</span>
        <h2 id="subjects-title">Explore your subjects</h2>
      </div>
      <a href="/explore/">Browse the library →</a>
    </div>
    <div class="card-grid subject-grid">
      {subjects.map((subject) => {
        const trail = categoryAncestors(subject.category, categories);
        const count = lessons.filter(
          (lesson) => lesson.data.subject === subject.id,
        ).length;
        return (
          <a class="panel card-link subject-card" href={subjectUrl(subject.id)}>
            <span class="subject-symbol" aria-hidden="true">
              <Icon name="book" size={22} />
            </span>
            <div>
              <span class="subject-category">
                {trail.map((category) => category.title).join(' / ')}
              </span>
              <h3>{subject.title}</h3>
              <p class="muted">{subject.description}</p>
              <span class="subject-meta">
                {count} {count === 1 ? 'lesson' : 'lessons'}{' '}
                <span aria-hidden="true">↗</span>
              </span>
            </div>
          </a>
        );
      })}
    </div>
    {subjects.length === 0 && (
      <p class="panel muted">Your library is ready for its first subject.</p>
    )}
  </section>
  {featured && (
    <section class="path-feature panel" aria-labelledby="path-title">
      <div>
        <span class="eyebrow">A place to begin</span>
        <h2 id="path-title">{featured.title}</h2>
        <p class="muted">{featured.description}</p>
      </div>
      <a href={pathUrl(featured.id)} class="button secondary">
        {featured.id === 'dsa-foundations'
          ? 'Open DSA foundations →'
          : `Open ${featured.title} →`}
      </a>
    </section>
  )}
  <section aria-labelledby="lessons-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Read. Experiment. Practise.</span>
        <h2 id="lessons-title">Inside the library</h2>
      </div>
      <a href="/concepts/">Find a concept →</a>
    </div>
    <div class="card-grid">
      {lessons.slice(0, 4).map((lesson) => (
        <LessonCard lesson={lesson} />
      ))}
    </div>
  </section>
  <section class="learning-loop" aria-label="The learning loop">
    <span class="eyebrow">Make the connection</span>
    <p>
      Learn <span>→</span> Visualize <span>→</span> Experiment <span>→</span>{' '}
      Practise <span>→</span> Recall <span>→</span> Revisit
    </p>
  </section>
</BaseLayout>
<style>
  .welcome {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 3rem;
    padding: 1rem 0 2.25rem;
  }
  h1 {
    font-size: clamp(2rem, 3.6vw, 3.3rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin: 0.9rem 0 1.1rem;
  }
  h1 span {
    color: var(--accent);
  }
  .welcome-copy .lede {
    font-size: 1rem;
    max-width: 48ch;
  }
  .library-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    color: var(--muted);
    font-size: 0.76rem;
    margin-top: 1.75rem;
  }
  .library-meta strong {
    color: var(--text);
    margin-right: 0.2rem;
  }
  .idea-preview {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: linear-gradient(145deg, var(--accent-soft), var(--surface) 60%);
    box-shadow: var(--shadow);
    padding: 1.5rem;
  }
  .preview-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .idea-preview h2 {
    font-size: 1.25rem;
    margin: 1.1rem 0 0.4rem;
  }
  .idea-preview p {
    font-size: 0.84rem;
  }
  figure {
    margin: 1.3rem 0 0;
  }
  .preview-cells {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .preview-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 0.55rem 0.2rem;
  }
  .preview-cell small,
  .preview-cell span {
    font: 0.62rem var(--font-mono);
    color: var(--muted);
  }
  .preview-cell strong {
    font: 1.65rem/1.8 var(--font-mono);
  }
  .preview-cell.selected {
    border-color: var(--accent);
    background: var(--accent-soft);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .preview-cell.selected span {
    color: var(--accent);
  }
  figcaption {
    text-align: center;
    font: 0.8rem var(--font-mono);
    padding: 0.9rem 0;
    color: var(--muted);
  }
  figcaption strong {
    color: var(--accent);
  }
  .preview-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    font-weight: 600;
    font-size: 0.82rem;
    text-decoration: none;
  }
  .section-heading h2 {
    margin-top: 0.4rem;
  }
  .section-heading > a {
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .subject-card {
    display: flex;
    align-items: start;
    gap: 1rem;
    padding: 1.4rem;
  }
  .subject-symbol {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 9px;
    color: var(--accent);
    background: var(--accent-soft);
    font: 1.2rem var(--font-mono);
  }
  .subject-category {
    font-size: 0.7rem;
    color: var(--muted);
  }
  .subject-card h3 {
    font-size: 1.2rem;
    margin: 0.4rem 0 0.6rem;
  }
  .subject-card p {
    font-size: 0.85rem;
    max-width: 65ch;
  }
  .subject-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.76rem;
    color: var(--accent);
    font-weight: 600;
  }
  .path-feature {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    margin: 1.5rem 0 0;
    padding: 1.6rem;
    border-left: 3px solid var(--accent);
  }
  .path-feature h2 {
    font-size: 1.3rem;
    margin: 0.4rem 0 0.6rem;
  }
  .path-feature p {
    font-size: 0.85rem;
    margin: 0;
    max-width: 65ch;
  }
  .path-feature .button {
    flex-shrink: 0;
    font-size: 0.8rem;
  }
  .learning-loop {
    border-top: 1px solid var(--border);
    margin-top: 2rem;
    padding-top: 1.6rem;
  }
  .learning-loop p {
    font-size: 0.85rem;
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    color: var(--muted);
  }
  .learning-loop p span {
    color: var(--accent);
  }
  @media (max-width: 1180px) {
    .welcome {
      gap: 1.5rem;
    }
    .path-feature {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 950px) {
    .welcome {
      grid-template-columns: 1fr;
    }
    .idea-preview {
      max-width: 620px;
    }
  }
  @media (max-width: 600px) {
    .welcome {
      padding-top: 0;
    }
    .idea-preview {
      padding: 1.1rem;
    }
    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.6rem;
    }
    .subject-card {
      padding: 1.1rem;
    }
    .subject-symbol {
      display: none;
    }
    .path-feature {
      padding: 1.2rem;
    }
  }
</style>
