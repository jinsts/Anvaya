---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
---

<BaseLayout title="Search">
  <PageHeader
    title="Search"
    description="Find lessons, learning paths, subjects and practice across your library."
    icon="search"
  />
  <form
    class="search-form"
    role="search"
    aria-label="Library"
    action="/concepts/"
  >
    <label for="search" class="sr-only">
      Search the library
    </label>
    <Icon name="search" size={20} />
    <input
      id="search"
      name="q"
      type="search"
      placeholder="Try arrays, collisions or amortized"
      autocomplete="off"
    />
    <button id="clear-search" type="button" class="button-ghost" hidden>
      Clear
    </button>
  </form>
  <p id="search-status" class="muted" role="status"></p>
  <ol id="results" class="results"></ol>
  <div class="card empty-state" id="empty" hidden>
    <h2>No matches yet</h2>
    <p>
      Try another word or a broader topic, or{' '}
      <a href="/explore/">browse your subjects</a>.
    </p>
  </div>
  <noscript>
    <p class="card">
      Search needs JavaScript. <a href="/explore/">Browse subjects</a> or{' '}
      <a href="/paths/">learning paths</a> instead.
    </p>
  </noscript>
</BaseLayout>
<script>
  import { initSearch } from '../../scripts/search';
  initSearch();
</script>
<style>
  .search-form {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--muted);
    box-shadow: var(--shadow-sm);
  }
  .search-form:focus-within {
    border-color: var(--accent);
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }
  .search-form input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    font-size: var(--text-lg);
  }
  #search-status {
    margin: var(--space-4) 0;
    font-size: var(--text-sm);
  }
  .results {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .results :global(.result) {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .results :global(.result-meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-1);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .results :global(h2) {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .results :global(h2 a) {
    color: var(--text);
    text-decoration: none;
  }
  .results :global(h2 a:hover) {
    color: var(--accent);
  }
  .results :global(.excerpt) {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .results :global(mark) {
    padding: 0 0.1em;
    border-radius: 3px;
    background: var(--warning-soft);
    color: var(--text);
  }
  .results :global(.sections) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .results :global(.sections a) {
    display: inline-flex;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    text-decoration: none;
  }
  .results :global(.sections a:hover) {
    border-color: var(--accent);
  }
  .empty-state h2 {
    font-size: var(--text-lg);
  }
  .empty-state p {
    margin: 0;
  }
</style>
