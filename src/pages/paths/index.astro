---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import PathCard from '../../components/catalog/PathCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { getCatalog } from '../../lib/catalog';
import { pathLessonIds } from '../../lib/path-model';
const { paths, lessonById, subjectById } = await getCatalog();
const activePaths = paths.filter((path) => pathLessonIds(path).length > 0);
---

<BaseLayout title="Learning paths">
  <PageHeader
    title="Learning paths"
    description="Follow a thoughtful sequence. Build each mental model before adding the next layer."
    icon="route"
  />
  {activePaths.length ? (
    <div class="card-grid">
      {activePaths.map((path) => (
        <PathCard
          path={path}
          subject={subjectById.get(path.subject)!}
          lessons={pathLessonIds(path).map((id) => lessonById.get(id)!)}
        />
      ))}
    </div>
  ) : (
    <p class="card empty-state">
      There aren’t any learning paths yet. You can still browse individual
      subjects.
    </p>
  )}
  <p class="browse-prompt">
    <Icon name="compass" size={18} />
    <span>
      Prefer to follow your own curiosity?{' '}
      <a href="/explore/">Explore all subjects</a>.
    </span>
  </p>
</BaseLayout>
<style>
  .browse-prompt {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    color: var(--muted);
  }
</style>
