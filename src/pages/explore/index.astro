---
import { plural } from '../../lib/format';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SubjectCard from '../../components/catalog/SubjectCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { getCatalog } from '../../lib/catalog';
import {
  categoryAncestors,
  categoryUrl,
  pathLessonIds,
} from '../../lib/path-model';
const {
  categories,
  availableSubjects: subjects,
  subjectById,
  lessons,
  paths,
  problemsByLesson,
} = await getCatalog();
const availablePaths = paths.filter((path) => pathLessonIds(path).length > 0);
const populated = categories.filter((category) =>
  subjects.some((subject) =>
    categoryAncestors(subject.category, categories).some(
      (ancestor) => ancestor.id === category.id,
    ),
  ),
);
---

<BaseLayout title="Explore subjects">
  <PageHeader
    title="Explore subjects"
    description="Browse by category, then open a subject to see its learning paths, lessons and practice."
    icon="compass"
  />
  <div class="catalog-browser">
    <nav class="category-panel" aria-label="Subject categories">
      <a class="all-subjects" href="/explore/" data-select-category="">
        <Icon name="layers" size={16} /> All subjects
      </a>
      <a href="/explore/" id="category-back" data-select-category="" hidden>
        <Icon name="arrow-left" size={15} />
        <span data-back-label>All categories</span>
      </a>
      <p id="category-group" class="category-group">
        Browse a category
      </p>
      <div class="category-options">
        {populated.map((category) => (
          <a
            href={categoryUrl(category.id)}
            data-select-category={category.id}
            data-category-id={category.id}
            data-parent={category.parent ?? ''}
            data-title={category.title}
            data-description={category.description}
          >
            <span>{category.title}</span>
            <Icon name="chevron-right" size={15} />
          </a>
        ))}
      </div>
      <div class="category-note">
        <p>Prefer a guided sequence?</p>
        <a href="/paths/">
          See learning paths <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </nav>
    <section class="subject-results" aria-labelledby="browse-title">
      <nav
        class="browse-breadcrumb"
        id="category-breadcrumb"
        aria-label="Category breadcrumb"
      >
        <span>All subjects</span>
      </nav>
      <div class="results-heading">
        <h2 id="browse-title" tabindex="-1">
          All subjects
        </h2>
        <span id="subject-count" class="muted" role="status">
          {plural(subjects.length, 'subject')}
        </span>
      </div>
      <p id="category-description" class="muted category-description">
        Explore the subjects in your library.
      </p>
      <div class="card-grid">
        {subjects.map((subject) => {
          const trail = categoryAncestors(subject.category, categories);
          const subjectLessons = lessons.filter(
            (lesson) => lesson.data.subject === subject.id,
          );
          return (
            <SubjectCard
              subject={subjectById.get(subject.id)!}
              trail={trail.map((category) => category.title).join(' / ')}
              categories={trail.map((category) => category.id).join(' ')}
              lessons={subjectLessons.length}
              paths={
                availablePaths.filter((path) => path.subject === subject.id)
                  .length
              }
              problems={
                new Set(
                  subjectLessons.flatMap((lesson) =>
                    (problemsByLesson.get(lesson.id) ?? []).map(
                      (problem) => problem.id,
                    ),
                  ),
                ).size
              }
            />
          );
        })}
      </div>
      <p class="card empty-state" id="no-subjects" hidden>
        No subjects in this category yet. Choose another category to keep
        exploring.
      </p>
      <div class="browse-help">
        <Icon name="search" size={18} />
        <p>
          Looking for a particular idea?{' '}
          <a href="/concepts/">Search the library</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  const categoryOptions = [
    ...document.querySelectorAll<HTMLAnchorElement>('[data-category-id]'),
  ];
  const categoryById = new Map(
    categoryOptions.map((option) => [
      option.dataset.categoryId!,
      {
        id: option.dataset.categoryId!,
        parent: option.dataset.parent ?? '',
        title: option.dataset.title ?? '',
        description: option.dataset.description ?? '',
      },
    ]),
  );
  const cards = [
    ...document.querySelectorAll<HTMLElement>('[data-subject-categories]'),
  ];
  const title = document.querySelector<HTMLElement>('#browse-title');
  const trail = document.querySelector<HTMLElement>('#category-breadcrumb');
  const back = document.querySelector<HTMLAnchorElement>('#category-back');
  const categoryHref = (id: string) =>
    id ? `/explore/?category=${encodeURIComponent(id)}` : '/explore/';
  function renderCategory() {
    const requested =
      new URLSearchParams(location.search).get('category') ?? '';
    const selected = categoryById.get(requested);
    const id = selected?.id ?? '';
    const children = categoryOptions.filter(
      (option) => option.dataset.parent === id,
    );
    const group = children.length ? id : (selected?.parent ?? '');
    categoryOptions.forEach((option) => {
      option.hidden = option.dataset.parent !== group;
      if (option.dataset.categoryId === id)
        option.setAttribute('aria-current', 'true');
      else option.removeAttribute('aria-current');
    });
    document
      .querySelector<HTMLAnchorElement>('.all-subjects')
      ?.setAttribute('aria-current', id ? 'false' : 'true');
    const groupLabel = document.querySelector('#category-group');
    if (groupLabel)
      groupLabel.textContent = selected
        ? children.length
          ? selected.title
          : 'Related categories'
        : 'Browse a category';
    if (back) {
      back.hidden = !id;
      back.href = categoryHref(selected?.parent ?? '');
      back.dataset.selectCategory = selected?.parent ?? '';
      const label = back.querySelector('[data-back-label]');
      if (label)
        label.textContent = selected?.parent
          ? (categoryById.get(selected.parent)?.title ?? 'Back')
          : 'All categories';
    }
    if (title) title.textContent = selected?.title ?? 'All subjects';
    const description = document.querySelector('#category-description');
    if (description)
      description.textContent =
        selected?.description ?? 'Explore the subjects in your library.';
    let count = 0;
    cards.forEach((card) => {
      card.hidden =
        !!id && !card.dataset.subjectCategories?.split(' ').includes(id);
      if (!card.hidden) count++;
    });
    const status = document.querySelector('#subject-count');
    if (status)
      status.textContent = `${count} ${count === 1 ? 'subject' : 'subjects'}`;
    const empty = document.querySelector<HTMLElement>('#no-subjects');
    if (empty) empty.hidden = count > 0;
    if (trail) {
      trail.replaceChildren();
      const chain = [];
      let cursor = selected;
      while (cursor) {
        chain.unshift(cursor);
        cursor = categoryById.get(cursor.parent);
      }
      const root = document.createElement('a');
      root.href = '/explore/';
      root.dataset.selectCategory = '';
      root.textContent = 'All subjects';
      trail.append(root);
      chain.forEach((category, index) => {
        const separator = document.createElement('span');
        separator.textContent = '/';
        separator.setAttribute('aria-hidden', 'true');
        trail.append(separator);
        const item = document.createElement(
          index === chain.length - 1 ? 'span' : 'a',
        );
        item.textContent = category.title;
        if (item instanceof HTMLAnchorElement) {
          item.href = categoryHref(category.id);
          item.dataset.selectCategory = category.id;
        } else item.setAttribute('aria-current', 'page');
        trail.append(item);
      });
    }
  }
  document
    .querySelector('.catalog-browser')
    ?.addEventListener('click', (event) => {
      if (
        !(event instanceof MouseEvent) ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        event.button !== 0
      )
        return;
      const link = (event.target as Element).closest<HTMLAnchorElement>(
        '[data-select-category]',
      );
      if (!link) return;
      event.preventDefault();
      history.pushState(null, '', link.href);
      renderCategory();
      title?.focus({ preventScroll: true });
    });
  window.addEventListener('popstate', renderCategory);
  renderCategory();
</script>
<style>
  .catalog-browser {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    align-items: start;
    gap: var(--space-8);
  }
  .category-panel {
    position: sticky;
    top: var(--sticky-offset);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .category-panel a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .category-options a {
    justify-content: space-between;
  }
  .category-panel a:hover {
    background: var(--subtle);
  }
  .category-panel a[aria-current='true'] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .category-group {
    margin: var(--space-3) 0 var(--space-1);
    padding: var(--space-3) var(--space-3) 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  #category-back {
    color: var(--accent);
  }
  .category-note {
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-3) var(--space-1);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
  }
  .category-note p {
    margin: 0 0 var(--space-1);
    color: var(--muted);
  }
  .category-panel .category-note a {
    padding: 0;
    color: var(--accent);
    font-weight: 600;
  }
  .category-panel .category-note a:hover {
    background: none;
  }
  .browse-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-height: 24px;
    margin-bottom: var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .browse-breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .browse-breadcrumb a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .results-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .results-heading h2 {
    margin: 0;
  }
  .results-heading > span {
    flex-shrink: 0;
    font-size: var(--text-sm);
  }
  .category-description {
    margin: var(--space-2) 0 var(--space-6);
  }
  .browse-help {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    color: var(--muted);
  }
  .browse-help p {
    margin: 0;
  }
  @media (max-width: 1000px) {
    .catalog-browser {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
  @media (max-width: 760px) {
    .catalog-browser {
      grid-template-columns: minmax(0, 1fr);
    }
    .category-panel {
      position: static;
    }
    .category-note {
      display: none;
    }
  }
</style>
