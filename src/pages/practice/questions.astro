---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { inlineMarkdown, plural } from '../../lib/format';
import { getCatalog, lessonLabel } from '../../lib/catalog';
import { lessonUrl } from '../../lib/path-model';
import { questionId } from '../../lib/practice-model';
const { lessons, availableSubjects } = await getCatalog();
const withQuestions = lessons.filter(
  (lesson) => lesson.data.interviewQuestions.length > 0,
);
const groups = availableSubjects
  .map((subject) => ({
    subject,
    lessons: withQuestions.filter(
      (lesson) => lesson.data.subject === subject.id,
    ),
  }))
  .filter((group) => group.lessons.length > 0);
const total = withQuestions.reduce(
  (count, lesson) => count + lesson.data.interviewQuestions.length,
  0,
);
---

<BaseLayout title="Question drill">
  <PageHeader
    title="Question drill"
    description="Answer each question out loud first, then compare with a model answer. Questions you mark for review come back first."
    icon="message-circle-question-mark"
  >
    <p class="header-links">
      <a href="/practice/">
        <Icon name="target" size={16} /> Practice problems
      </a>
    </p>
  </PageHeader>

  <section class="card drill js-only" aria-label="Question drill" data-drill>
    <div class="drill-toolbar">
      <label>
        <span class="sr-only">Topic</span>
        <select data-drill-filter>
          <option value="">All topics</option>
          {groups.map((group) => (
            <optgroup label={group.subject.title}>
              <option value={`subject:${group.subject.id}`}>
                All {group.subject.title}
              </option>
              {group.lessons.map((lesson) => (
                <option value={lesson.id}>{lessonLabel(lesson)}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </label>
      <p class="drill-progress muted" data-drill-progress></p>
    </div>
    <div class="drill-card" data-drill-card>
      <p class="eyebrow" data-drill-context></p>
      <h2 class="drill-prompt" data-drill-prompt tabindex="-1">
        Question
      </h2>
      <div class="drill-answer" data-drill-answer hidden></div>
      <div class="actions">
        <button type="button" class="button-primary" data-drill-reveal>
          Reveal answer
        </button>
        <button type="button" data-drill-result="again" hidden>
          Review again
        </button>
        <button
          type="button"
          class="button-primary"
          data-drill-result="known"
          hidden
        >
          <Icon name="check" size={16} /> I explained it well
        </button>
      </div>
    </div>
    <div class="drill-done" data-drill-done hidden>
      <p>
        Round complete. Questions marked for review will come first next time.
      </p>
      <button type="button" data-drill-restart>
        Start another round
      </button>
    </div>
    <p class="sr-only" role="status" data-drill-status></p>
  </section>

  <section aria-labelledby="all-questions">
    <div class="section-head">
      <h2 id="all-questions">All questions</h2>
      <p class="muted">{plural(total, 'question')}</p>
    </div>
    {groups.length === 0 && (
      <p class="card empty-state">
        No interview questions yet. Lessons add them in their frontmatter.
      </p>
    )}
    {groups.map((group) =>
      group.lessons.map((lesson) => (
        <section
          class="question-group"
          aria-labelledby={`questions-${lesson.id.replace('/', '-')}`}
        >
          <h3 id={`questions-${lesson.id.replace('/', '-')}`}>
            <a href={lessonUrl(lesson.id)}>{lesson.data.title}</a>
          </h3>
          {lesson.data.interviewQuestions.map((question) => (
            <details
              class="question"
              data-question={questionId(lesson.id, question.prompt)}
              data-lesson={lesson.id}
              data-context={`${group.subject.title} · ${lessonLabel(lesson)}`}
            >
              <summary set:html={inlineMarkdown(question.prompt)} />
              <div class="answer">
                <p set:html={inlineMarkdown(question.answer)} />
                {question.followUps.length > 0 && (
                  <>
                    <p class="follow-label">Likely follow-ups</p>
                    <ul>
                      {question.followUps.map((followUp) => (
                        <li set:html={inlineMarkdown(followUp)} />
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </details>
          ))}
        </section>
      )),
    )}
  </section>
</BaseLayout>
<script>
  import { initDrill } from '../../scripts/drill';
  initDrill();
</script>
<style>
  .header-links {
    margin: var(--space-4) 0 0;
  }
  .header-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    text-decoration: none;
  }
  .drill-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  .drill-toolbar select {
    font-size: var(--text-sm);
  }
  .drill-progress {
    margin: 0;
    font-size: var(--text-sm);
  }
  .drill-card {
    padding-top: var(--space-5);
  }
  .drill-card .eyebrow {
    color: var(--accent);
  }
  .drill-prompt {
    max-width: var(--article-measure);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    outline: none;
  }
  .drill-answer {
    max-width: var(--article-measure);
    margin-bottom: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--success);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--success-soft);
  }
  .drill-answer :global(p:last-child),
  .drill-answer :global(ul) {
    margin-bottom: 0;
  }
  .drill-done {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-5);
  }
  .drill-done p {
    margin: 0;
  }
  .question-group h3 {
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--text-base);
  }
  .question-group h3 a {
    text-decoration: none;
  }
  .question {
    max-width: var(--article-measure);
    margin-bottom: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .question summary {
    padding: var(--space-3) var(--space-4);
    font-weight: 600;
    line-height: var(--leading-snug);
    cursor: pointer;
  }
  .question[open] summary {
    border-bottom: 1px solid var(--border);
  }
  .answer,
  .drill-answer {
    font-size: var(--text-base);
  }
  .answer {
    padding: var(--space-4) var(--space-5);
  }
  .answer > :last-child {
    margin-bottom: 0;
  }
  .follow-label,
  .drill-answer :global(.follow-label) {
    margin-bottom: var(--space-1);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .answer ul {
    margin: 0;
    padding-left: var(--space-5);
  }
</style>
