---
import { Code } from 'astro:components';
import Icon from '../ui/Icon.astro';
interface Props {
  code: string;
  output?: string;
  language?: 'ts' | 'js' | 'bash';
  title: string;
  /** Set only when a test or command actually checks `output`. */
  verified?: boolean;
}
const { code, output, language = 'ts', title, verified = false } = Astro.props;
const languageName = { ts: 'TypeScript', js: 'JavaScript', bash: 'Shell' };
---

<figure class="code-example">
  <figcaption class="code-header">
    <span class="code-title">
      <Icon name="code" size={16} /> {title}
    </span>
    <span class="code-language">{languageName[language]}</span>
    <button
      type="button"
      class="copy-code"
      data-code={code}
      aria-label={`Copy ${title}`}
    >
      <Icon name="copy" size={15} />
      <span data-copy-label>Copy</span>
    </button>
    <span class="copy-status sr-only" role="status"></span>
  </figcaption>
  <Code
    code={code}
    lang={language}
    themes={{
      light: 'github-light-high-contrast',
      dark: 'github-dark-high-contrast',
    }}
  />
  {output && (
    <div class="output">
      <p class="output-label">
        <Icon name={verified ? 'circle-check' : 'info'} size={15} />
        {verified ? 'Expected output · verified by tests' : 'Expected output'}
      </p>
      <pre>{output}</pre>
    </div>
  )}
</figure>
<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-code').forEach((button) =>
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector('.copy-status');
      const label = button.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(button.dataset.code ?? '');
        if (status) status.textContent = 'Code copied.';
        if (label) label.textContent = 'Copied';
      } catch {
        if (status)
          status.textContent =
            'Copy unavailable. Select the code to copy it manually.';
        if (label) label.textContent = 'Select manually';
      }
    }),
  );
</script>
<style>
  .code-example {
    margin: var(--space-6) 0;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--code-bg);
  }
  .code-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border);
    background: var(--subtle);
    font-size: var(--text-sm);
  }
  .code-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    font-weight: 600;
  }
  .code-language {
    margin-left: auto;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .copy-code {
    min-height: 32px;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
  }
  .code-example :global(pre) {
    border: 0;
    border-radius: 0;
  }
  .output {
    border-top: 1px solid var(--border);
    background: var(--success-soft);
  }
  .output-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) var(--space-4) 0;
    color: var(--success);
    font-size: var(--text-xs);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .output pre {
    padding: var(--space-2) var(--space-4) var(--space-4);
    border: 0;
    background: transparent;
    white-space: pre-wrap;
  }
</style>
