---
import type { CollectionEntry } from 'astro:content';
import { lessonUrl } from '../../lib/path-model';
interface Props {
  lesson: CollectionEntry<'lessons'>;
  number?: number;
  pathId?: string;
}
const { lesson, number, pathId } = Astro.props;
const context = pathId === lesson.data.path ? undefined : pathId;
---

<a class="panel card-link lesson-card" href={lessonUrl(lesson.id, context)}>
  <div class="card-meta">
    <span class="eyebrow">
      {number
        ? `Lesson ${String(number).padStart(2, '0')}`
        : lesson.data.difficulty}
    </span>
    <span class="badge">{lesson.data.estimatedMinutes} min</span>
  </div>
  <h3>{lesson.data.title}</h3>
  <p class="muted">{lesson.data.summary}</p>
  <span class="review-status">
    {lesson.data.status === 'draft'
      ? 'Draft · awaiting review'
      : lesson.data.status}
  </span>
  <span class="card-foot">
    {lesson.data.tags.slice(0, 3).join(' / ')}
    <span aria-hidden="true">↗</span>
  </span>
</a>
<style>
  .lesson-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem;
  }
  .card-meta,
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .card-foot {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: auto;
  }
  h3 {
    color: var(--text);
    font-size: 1.2rem;
    line-height: 1.35;
    margin: 1rem 0 0.65rem;
  }
  p {
    font-size: 0.88rem;
  }
  .review-status {
    color: var(--muted);
    font-size: 0.73rem;
    margin-bottom: 1rem;
  }
</style>
