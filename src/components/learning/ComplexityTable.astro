---
interface Row {
  operation: string;
  time: string;
  notes: string;
}
interface Props {
  caption: string;
  rows: Row[];
  /** Accessible name for the scrollable region; defaults to the caption. */
  label?: string;
}
const { caption, rows, label = caption } = Astro.props;
---

<div class="table-scroll" tabindex="0" role="region" aria-label={label}>
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Operation</th>
        <th scope="col">Time</th>
        <th scope="col">Why / auxiliary space</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.operation}</th>
          <td class="time">{row.time}</td>
          <td>{row.notes}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
{Astro.slots.has('default') && (
  <div class="complexity-note">
    <slot />
  </div>
)}
<style>
  .time {
    font-weight: 600;
  }
  .complexity-note {
    max-width: var(--article-measure);
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
