---
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<figure class="diagram-frame">
  <slot />
  <figcaption>{caption}</figcaption>
</figure>
<style>
  .diagram-frame {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
</style>
