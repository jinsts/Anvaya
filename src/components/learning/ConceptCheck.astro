---
interface Props {
  id: string;
  question: string;
  options: { label: string; explanation: string; correct?: boolean }[];
}
const { id, question, options } = Astro.props;
---

<form class="concept-check" data-quiz>
  <fieldset>
    <legend>
      <span class="eyebrow">Check your mental model</span>
      <span class="question">{question}</span>
    </legend>
    {options.map((option, i) => (
      <label>
        <input
          type="radio"
          name={id}
          value={i}
          data-correct={String(!!option.correct)}
          data-explanation={option.explanation}
          required
        />
        {option.label}
      </label>
    ))}
  </fieldset>
  <div class="actions">
    <button type="submit">Check reasoning</button>
    <button type="reset">Try again</button>
  </div>
  <p class="quiz-feedback" role="status" aria-live="polite"></p>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-quiz]').forEach((form) => {
    const feedback = form.querySelector<HTMLElement>('.quiz-feedback');
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const chosen = form.querySelector<HTMLInputElement>('input:checked');
      if (feedback && chosen) {
        feedback.textContent = `${chosen.dataset.correct === 'true' ? 'Exactly.' : 'Reconsider.'} ${chosen.dataset.explanation}`;
      }
    });
    form.addEventListener('reset', () => {
      if (feedback) feedback.textContent = '';
    });
  });
</script>
<style>
  .concept-check {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--accent-soft);
    border-radius: var(--radius);
  }
  fieldset {
    padding: 0;
    margin: 0;
    border: 0;
  }
  legend {
    margin-bottom: 1rem;
  }
  legend span {
    display: block;
  }
  .question {
    margin-top: 0.75rem;
    font-weight: 600;
  }
  label {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.65rem 0;
    font-size: 0.9rem;
    cursor: pointer;
  }
  input {
    accent-color: var(--accent);
  }
  .actions {
    margin: 1rem 0;
  }
  .quiz-feedback {
    margin: 0;
    font-size: 0.85rem;
  }
</style>
