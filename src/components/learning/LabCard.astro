---
interface Props {
  title: string;
  command: string;
}
const { title, command } = Astro.props;
---

<section class="lab-card">
  <span class="eyebrow">Independent practice</span>
  <h3>{title}</h3>
  <slot />
  <p>
    <strong>Run locally from the repository root:</strong>
  </p>
  <pre><code>{command}</code></pre>
</section>
<style>
  .lab-card {
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.5rem;
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }
  .lab-card h3 {
    margin-top: 0.7rem;
  }
  .lab-card pre {
    font-size: 0.8rem;
  }
</style>
