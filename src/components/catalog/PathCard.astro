---
import { plural } from '../../lib/format';
import Icon from '../ui/Icon.astro';
import { pathUrl, plannedCount, type LearningPath } from '../../lib/path-model';
import {
  lessonLabel,
  lessonUrlIn,
  type CatalogSubject,
  type Lesson,
} from '../../lib/catalog';
interface Props {
  path: LearningPath;
  subject: CatalogSubject;
  lessons: Lesson[];
}
const { path, subject, lessons } = Astro.props;
const minutes = lessons.reduce(
  (total, lesson) => total + lesson.data.estimatedMinutes,
  0,
);
const planned = plannedCount(path);
const first = lessons[0];
---

<article class="card path-card" data-tone={subject.tone} data-progress-scope>
  <div class="path-top">
    <span class="icon-tile">
      <Icon name={subject.icon} size={20} />
    </span>
    <span class="eyebrow">{subject.title}</span>
  </div>
  <h3>
    <a class="stretched-link" href={pathUrl(path.id)}>
      {path.title}
    </a>
  </h3>
  <p class="muted">{path.description}</p>
  <p class="path-facts">
    <span>
      <Icon name="book-open" size={14} />
      {plural(lessons.length, 'lesson')}
    </span>
    <span>
      <Icon name="clock" size={14} /> {minutes} min
    </span>
    {planned > 0 && (
      <span>
        <Icon name="circle-dashed" size={14} /> {planned} planned
      </span>
    )}
  </p>
  {first && (
    <div class="path-progress js-only">
      <div
        class="progress"
        role="progressbar"
        aria-label={`Progress in ${path.title}`}
        aria-valuemin="0"
        aria-valuemax={lessons.length}
        aria-valuenow="0"
        data-progress-bar
      />
      <p class="progress-meta">
        <span data-progress-text>0 of {lessons.length} complete</span>
        <span data-progress-next-wrap>
          Next:{' '}
          <a data-progress-next href={lessonUrlIn(first, path.id)}>
            {lessonLabel(first)}
          </a>
        </span>
        <span data-progress-done hidden>
          Path complete
        </span>
      </p>
    </div>
  )}
  <ol hidden>
    {lessons.map((lesson) => (
      <li>
        <a
          href={lessonUrlIn(lesson, path.id)}
          data-lesson-id={lesson.id}
          data-label={lessonLabel(lesson)}
        >
          {lessonLabel(lesson)}
        </a>
      </li>
    ))}
  </ol>
</article>
<style>
  .path-card {
    display: flex;
    flex-direction: column;
  }
  .path-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .path-top .eyebrow {
    margin: 0;
  }
  h3 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .muted {
    font-size: var(--text-sm);
  }
  .path-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: auto 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 550;
  }
  .path-facts span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .path-progress {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .progress-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .progress-meta a {
    font-weight: 600;
  }
</style>
